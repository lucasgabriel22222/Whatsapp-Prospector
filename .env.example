# =============================================
# EVOLUTION API (WhatsApp)
# =============================================
EVOLUTION_API_URL=http://localhost:8080
API_KEY=sua_api_key_aqui
INSTANCE_NAME=nome_da_sua_instancia

# =============================================
# GOOGLE GEMINI AI
# =============================================
GEMINI_API_KEY=sua_gemini_api_key_aqui

# =============================================
# CONFIGURAÇÕES DE DISPARO
# =============================================
# Delay mínimo entre mensagens (segundos)
DELAY_MIN=45
# Delay máximo entre mensagens (segundos)
DELAY_MAX=90
# Limite de envios por sessão (0 = sem limite)
LIMITE_ENVIOS=50

# =============================================
# SCRAPER GOOGLE MAPS
# =============================================
# Número máximo de resultados por busca
SCRAPER_MAX_RESULTS=50
# Mostrar navegador durante scraping? (true/false)
SCRAPER_HEADLESS=true

# =============================================
# WEBHOOK LISTENER (porta para receber respostas)
# =============================================
WEBHOOK_PORT=3001

# =============================================
# APIFY API (Google Maps Scraper)
# =============================================
APIFY_API_TOKEN=apify_api_sua_chave_aqui

